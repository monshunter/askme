ASKME_POSTGRES_DB=askme
ASKME_POSTGRES_USER=askme
ASKME_POSTGRES_PASSWORD=askme-local-only
ASKME_CANDIDATE_EMAIL=candidate@askme.local
ASKME_CANDIDATE_PASSWORD=Candidate-local-2026!
ASKME_ADMIN_EMAIL=admin@askme.local
ASKME_ADMIN_PASSWORD=Admin-local-2026!
ASKME_PUBLIC_BASE_URL=https://askme.monshunter.xyz/
ASKME_AI_BASE_URL=https://api.deepseek.com/v1
ASKME_AI_ROUTER_MODEL=deepseek-v4-flash
ASKME_AI_ROUTER_THINKING=off
ASKME_AI_RAG_MODEL=deepseek-v4-flash
ASKME_AI_RAG_THINKING=off
ASKME_AI_CODE_MODEL=deepseek-v4-pro
ASKME_AI_CODE_THINKING=high
ASKME_AI_CODE_CONTEXT_WINDOW=1000000
ASKME_AI_CODE_MAX_TOKENS=200000
ASKME_AI_PLANNER_MODEL=deepseek-v4-flash
ASKME_AI_PLANNER_THINKING=off
ASKME_AI_VERIFIER_MODEL=deepseek-v4-flash
ASKME_AI_VERIFIER_THINKING=off
# Embedding and Rerank are independent providers. Configure both key and base URL for each enabled provider.
ASKME_EMBEDDING_MODEL_API_KEY=
ASKME_EMBEDDING_MODEL_API_BASE_URL=
ASKME_EMBEDDING_MODEL=qwen3.7-text-embedding
ASKME_EMBEDDING_DIMENSIONS=1024
ASKME_EMBEDDING_TIMEOUT_MS=20000
ASKME_EMBEDDING_MAX_RETRIES=1
ASKME_EMBEDDING_BATCH_SIZE=16
ASKME_EMBEDDING_CONCURRENCY=2
ASKME_RERANK_MODEL_API_KEY=
# qwen3-rerank uses the Workspace-specific .../compatible-api/v1 base URL.
ASKME_RERANK_MODEL_API_BASE_URL=
ASKME_RERANK_MODEL=qwen3-rerank
ASKME_RERANK_PROVIDER_PROTOCOL=dashscope-compatible
ASKME_RERANK_TIMEOUT_MS=20000
ASKME_RERANK_MAX_RETRIES=1
ASKME_RERANK_TOP_N=8
ASKME_RAG_POLICY_VERSION=hybrid-rag-v2
ASKME_RAG_EXACT_TOP_K=20
ASKME_RAG_LEXICAL_TOP_K=30
ASKME_RAG_VECTOR_TOP_K=30
ASKME_RAG_STRUCTURED_TOP_K=20
ASKME_RAG_EXACT_WEIGHT=1.5
ASKME_RAG_LEXICAL_WEIGHT=1
ASKME_RAG_VECTOR_WEIGHT=1
ASKME_RAG_STRUCTURED_WEIGHT=1.2
ASKME_RAG_RRF_K=60
ASKME_RAG_MAX_CHILDREN_PER_PARENT=3
ASKME_RAG_RETRIEVAL_MAX_ROUNDS=2
ASKME_RAG_EVIDENCE_MAX_TOKENS=200000
ASKME_RAG_OUTPUT_RESERVE_TOKENS=8000
ASKME_RAG_SAFETY_MARGIN_TOKENS=4000
ASKME_RAG_CHILD_TARGET_TOKENS=420
ASKME_RAG_CHILD_MIN_TOKENS=80
ASKME_RAG_CHILD_HARD_MAX_TOKENS=650
ASKME_RAG_PARENT_MIN_TOKENS=900
ASKME_RAG_PARENT_MAX_TOKENS=1500
ASKME_RAG_OVERLAP_TOKENS=48
ASKME_REPOSITORY_DOCUMENT_INCLUDE=README*.md,*.md,docs/**/*.md,docs/**/*.pdf
ASKME_REPOSITORY_DOCUMENT_EXCLUDE=**/node_modules/**,**/.git/**,**/dist/**,**/build/**,**/coverage/**
ASKME_REPOSITORY_MARKDOWN_MAX_BYTES=2097152
ASKME_REPOSITORY_PDF_MAX_BYTES=52428800
ASKME_REPOSITORY_PDF_MAX_PAGES=500
ASKME_REPOSITORY_REVISION_MAX_TOKENS=5000000
ASKME_REPOSITORY_ARTIFACT_ROOT=./data/repository-artifacts
ASKME_REPOSITORY_ARTIFACT_HOST_ROOT=./data/repository-artifacts
# Build the Host-native BoxLite OCI layout with scripts/build-code-agent-image.sh.
ASKME_CODE_AGENT_ROOTFS_PATH=./data/code-agent-image
ASKME_CODE_AGENT_RUNTIME_ROOT=./data/boxlite
# Set this to the digest printed by scripts/build-code-agent-image.sh.
ASKME_CODE_AGENT_IMAGE_DIGEST=
ASKME_CODE_AGENT_MAX_ROUNDS=50
ASKME_CODE_AGENT_MAX_TOOL_CALLS=80
ASKME_CODE_AGENT_REPOSITORY_DAILY_QUOTA=10
ASKME_CODE_AGENT_REPOSITORY_ANALYSIS_TIMEOUT_MS=1200000
# Local Compose sends Candidate reset and Admin invitation mail to Mailpit.
ASKME_MAILPIT_PORT=8025
ASKME_SMTP_HOST=mailpit
ASKME_SMTP_PORT=1025
ASKME_SMTP_SECURE=false
ASKME_SMTP_USER=
ASKME_SMTP_PASSWORD=
ASKME_SMTP_FROM=Askme <noreply@askme.local>
